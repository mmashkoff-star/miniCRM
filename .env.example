# ID таблицы из URL: https://docs.google.com/spreadsheets/d/<SPREADSHEET_ID>/edit
SPREADSHEET_ID=

# Имя листа (по умолчанию Sheet1)
SHEET_NAME=Invoices

# Путь к JSON-ключу сервисного аккаунта (для integrations/google_sheets.py)
GOOGLE_CREDENTIALS_PATH=credentials/excel-factory-512714-341d64a29ff2.json

# Drive: oauth — от имени пользователя, service_account — от имени SA
GOOGLE_AUTH=oauth
GOOGLE_OAUTH_CLIENT_SECRET=credentials/client_secret_....apps.googleusercontent.com.json
GOOGLE_OAUTH_TOKEN_PATH=credentials/token.json

# Папка Google Drive. Пусто = все файлы, доступные текущему аккаунту
DRIVE_FOLDER_ID=

# Файл SQLite мини-CRM
CRM_DB_PATH=data/crm.sqlite3

# URL API для окна Tkinter (Docker публикует CRM на 8020)
CRM_API_URL=http://127.0.0.1:8020
